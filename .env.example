# Copy to .env (repo root) and fill in. Never commit .env.
# No secret ever goes into the sandbox container.

# --- Vultr Serverless Inference (OpenAI-compatible). The LLM explains only. ---
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Fast-path AI check (2 s budget) and the explanation fallback. Also for the demo.
# Measured comparison: README Results / backend/llm_eval.py.
VULTR_MODEL=glm-5.3-flash
# Background explanation card only (never on the 2 s budget): bigger model, own timeout,
# falls back to VULTR_MODEL if it fails or times out. Empty = VULTR_MODEL for everything.
VULTR_EXPLAIN_MODEL=glm-5.3
LLM_EXPLAIN_TIMEOUT_SECONDS=20
# auto = real client if a key is set, mock otherwise | mock | live
LLM_MODE=auto
# One retry (none after a 429), then no explanation. LLM failure never changes the verdict.
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
# Thinking tokens are billed and slow; minimal keeps glm-5.3-flash under the 2 s fast-path budget.
LLM_REASONING_EFFORT=minimal
LLM_JSON_MODE=true
# Mock only (no Vultr key yet): simulated model latency and share of plain transfers it escalates
MOCK_LLM_LATENCY_MS=800
MOCK_LLM_ESCALATE_RATE=0
# Fast path: the LLM may only say "escalate to slow path" or "no change", never a verdict.
# LLM error or timeout on the fast path -> slow path. Set false to measure without it.
FAST_PATH_LLM_ESCALATION=true
# The escalation call has its own short timeout; a timeout sends the request to the slow path
FAST_PATH_LLM_TIMEOUT_SECONDS=2
# Escalation policy: a destination this wallet never paid before -> full simulation (no AI first).
# A known destination: ask the AI only for an amount above this % of the wallet balance;
# a small amount: rules alone. The AI still writes the explanation after a full simulation.
AI_CHECK_MIN_PCT=10
# ALL Vultr calls at once (fast-path checks + explanations). Checks go first, explanations wait.
# A check with no free slot within the 2 s budget -> full simulation (never ALLOW).
LLM_CONCURRENCY=3
# Daily model spend cap in USD (UTC day; 0 = none). Reached: the AI check counts as unavailable
# (full simulation) and explanations pause ("Demo budget reached"); never the mock instead.
LLM_DAILY_BUDGET_USD=1
# Keeps today's spend across restarts (empty = in memory). VM: /var/lib/fail-closed/llm_budget.json
LLM_BUDGET_FILE=

# --- Public demo (the VM / a tunnel): raw /check and /withdraw need ADMIN_TOKEN, per-IP rate
# limits, a visitor's demo runs reset after this many idle minutes (or with "Reset demo").
PUBLIC_DEMO=false
DEMO_IDLE_RESET_MINUTES=10
RATE_REPLAYS_PER_MINUTE=10
RATE_SIMULATIONS_PER_10_MINUTES=2
RATE_DEMO_ACTIONS_PER_MINUTE=30
RATE_POLLS_PER_MINUTE=300
# Live updates in the page: sse (Server-Sent Events first, polling if the stream fails) | poll
# (always poll; e.g. behind a Cloudflare quick tunnel, which does not pass SSE)
LIVE_UPDATES=sse
# Which local proxy may tell us the visitor IP (only for requests from 127.0.0.1):
# caddy (X-Forwarded-For, the VM) | cloudflared (CF-Connecting-IP, Plan B) | none
TRUSTED_PROXY=caddy
# Where the demo runs, for the page footer: vm | laptop
DEPLOY_TARGET=vm

# --- Sandbox: fresh container per check, always destroyed ---
# Built FROM ghcr.io/foundry-rs/foundry:v1.8.5 (contracts compiled at build time).
SANDBOX_IMAGE=fail-closed-sandbox:foundry-v1.8.5
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS=128
# At most this many sandboxes at once; wait this long for a slot, then 503 "Guard busy"
SANDBOX_MAX_CONCURRENT=4
# Laptop safety: below this much free RAM (GB) no new sandbox starts; new slow-path work waits,
# then "Guard busy" (never an approval). 0 = off. Plan B: 0.75 and SANDBOX_POOL_SIZE=2.
RAM_GUARD_MIN_FREE_GB=0
SANDBOX_QUEUE_SECONDS=10
# fresh = a new container per check | warm = a pool of ready containers, evm_snapshot/revert
# per check, clean check before reuse, destroyed after any error
SANDBOX_MODE=fresh
SANDBOX_POOL_SIZE=4
SANDBOX_MAX_USES=50
SANDBOX_MAX_AGE_SECONDS=600

# --- Guard approval key (ed25519) ---
# Generated on first start. Must be OUTSIDE the repo, owner-only (mode 600). Never in the sandbox.
GUARD_KEY_PATH=~/.fail-closed/guard_ed25519.pem
APPROVAL_TTL_SECONDS=120

# --- History (SQLite) ---
HISTORY_DB=data/history.sqlite3

# --- Guard-side policy lists (JSON arrays of addresses) ---
# ERC-20s whose transfer(address,uint256) counts as a plain withdrawal
KNOWN_TOKENS=[]
# EIP-7702 delegates that are allowed (R1)
DELEGATE_ALLOWLIST=[]
# Destinations a treasury wallet may pay (R5)
TREASURY_ALLOWLIST=[]

# --- Rule thresholds (starting values; tune later) ---
DELAY_MINUTES=15
# How often the DELAY worker checks held requests (it re-checks the rules before any release)
DELAY_CHECK_SECONDS=5
# R2: an authorization with a nonce next to a recent one (same authority) within this window
R2_WINDOW_HOURS=24
# R3: wallet loses more than this % of its balance to one non-allowlisted address -> BLOCK
R3_MAX_SINGLE_DEST_PCT=25
# R4 (treasury): amount above limit -> NEEDS_HUMAN. Native asset only for now (wei).
R4_TREASURY_LIMIT_WEI=10000000000000000000
# R6: wallet outflow within the window above limit -> BLOCK. Native asset only for now (wei).
R6_WINDOW_MINUTES=60
R6_OUTFLOW_LIMIT_WEI=50000000000000000000
# R7: same destination receives from >= N chains within the window
R7_WINDOW_HOURS=6
R7_DELAY_CHAINS=3
R7_FREEZE_CHAINS=5
# R8: >= N different assets to one address within the window -> freeze that address
R8_WINDOW_MINUTES=30
R8_FREEZE_ASSETS=10

# --- Circuit breaker levels 3-4 (latched; admin reset, logged) ---
# Level 3, safe mode on one chain: this many wallets paused, or this many R1/R2/R3-evidence
# BLOCKs, on that chain within the window. Safe mode: no fast path, every request NEEDS_HUMAN.
SAFE_MODE_PAUSED_WALLETS=2
SAFE_MODE_EVIDENCE_BLOCKS=3
SAFE_MODE_WINDOW_MINUTES=60
# Level 4, global stop (no approvals at all): at least this many independent signals
# (safe mode on a chain counts once per chain; a red-team payload NOT contained counts once).
GLOBAL_STOP_SIGNALS=2

# --- API (runs on the host with uvicorn) ---
# Needed for POST /breaker/reset (header X-Admin-Token). Empty = reset disabled.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# true: POST /redteam/run without the admin token (one run at a time; same sandbox limits)
REDTEAM_PUBLIC=false
# Only the local frontend for now
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Mock signer replay store (used approval ids)
SIGNER_DB=data/signer.sqlite3
