# Copy to .env and fill in. Never commit .env.

# --- Vultr Serverless Inference (OpenAI-compatible) ---
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Tool-calling capable. Default is fast and cheap.
# For the demo video, switch to the stronger model by changing only this line:
#   VULTR_MODEL=glm-5.3
# Other tool-calling options: deepseek-v4.1-flash-1017, mimo-v2.6-pro, qwen3.8-flash-next.
VULTR_MODEL=glm-5.3-flash
# auto = real client if a key is set, mock otherwise | mock | live
LLM_MODE=auto
LLM_TIMEOUT_SECONDS=20
# One quick retry, then fail closed (BLOCK).
LLM_MAX_RETRIES=1

# --- Sandbox (throwaway Anvil container per request) ---
SANDBOX_IMAGE=fail-closed-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=512m

# --- Policies ---
# Approvals at or above this amount are BLOCKED as "unlimited". Decimal or 0x-hex.
# Default 2^128 (~3.4e38) catches max-style values (2^256-1, 2^255, ...).
# It does NOT catch every effectively-unlimited amount (e.g. 1e30, SHIB supply ~5.9e32).
# TODO: compare against owner balance / totalSupply once we have chain state.
APPROVAL_LARGE_THRESHOLD=0x100000000000000000000000000000000
